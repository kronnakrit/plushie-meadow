{
  "name": "plushie-meadow",
  "version": "0.1.0",
  "description": "Plushie Meadow: a felt-stitched learning game for ages 3 to 6",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kronnakrit/plushie-meadow.git"
  },
  "bugs": {
    "url": "https://github.com/kronnakrit/plushie-meadow/issues"
  },
  "homepage": "https://github.com/kronnakrit/plushie-meadow#readme",
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.2",
    "@fontsource/andika": "^5.3.0",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module"
}
